{
  "name": "ansible-dev-container-codespaces",
  "image": "ghcr.io/ansible/community-ansible-dev-tools:latest",
  "containerUser": "root",
  "runArgs": [
    "--security-opt",
    "seccomp=unconfined",
    "--security-opt",
    "label=disable",
    "--cap-add=SYS_ADMIN",
    "--cap-add=SYS_RESOURCE",
    "--device",
    "/dev/fuse",
    "--security-opt",
    "apparmor=unconfined",
    "--hostname=ansible-dev-container"
  ],
  "updateRemoteUserUID": true,
  "features": {
    "ghcr.io/devcontainers-extra/features/prek:1": {},
    "ghcr.io/devcontainers-extra/features/claude-code:2.0.3": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.ansible",
        "redhat.vscode-redhat-account",
        "edwinhuish.better-comments-next"]
    }
  },
  "postCreateCommand": {
    "prek": "prek install -f --install-hooks"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/ansible_collections/marshallwp/general,type=bind",
  "workspaceFolder": "/ansible_collections/marshallwp/general"
}
